# --- Front (exposées au navigateur : uniquement des valeurs publiques) ---
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# --- Serveur (Vercel, jamais exposées au navigateur) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Rédaction IA : désactivée par défaut. Coût à l'usage, à activer seulement après accord de Yannis.
AI_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Plafond de sécurité : nombre maximal de générations IA par jour (toutes personnes confondues)
AI_DAILY_LIMIT=50
# Secret partagé pour la tâche quotidienne (Vercel Cron envoie Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# --- Agent de prospection ---
# API Offres d'emploi v2 de France Travail : créer une application sur https://francetravail.io (gratuit)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Nombre maximal de fiches recherchées par l'IA par jour (recherche web + rédaction de la première approche)
RESEARCH_DAILY_LIMIT=10
